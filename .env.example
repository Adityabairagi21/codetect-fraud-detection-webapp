# Copy to .env and fill in. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# MySQL (create the database and user with database/setup_mysql.sql first)
DATABASE_URL=mysql+pymysql://codetect_app:YOUR_DB_PASSWORD@localhost:3306/codetect?charset=utf8mb4

# Optional overrides
# ML_ARTIFACTS_DIR=ml_artifacts
# UPLOAD_FOLDER=uploads
# REPORTS_FOLDER=reports
# MAX_UPLOAD_MB=50
# MAX_DATASET_ROWS=200000
